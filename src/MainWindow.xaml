<Window x:Class="PcControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Control" Width="440" Height="780"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Muted" Color="#8C8C8C"/>
        <SolidColorBrush x:Key="Faint" Color="#555555"/>
        <SolidColorBrush x:Key="Line" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="Card" Color="#0B0B0B"/>
        <SolidColorBrush x:Key="Raised" Color="#151515"/>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Faint}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,22,0,10"/>
        </Style>

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1A1A1A"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented chip: white when it is the monitor's current input -->
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Foreground" Value="#BDBDBD"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" BorderBrush="#2A2A2A" BorderThickness="1"
                                CornerRadius="9" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="#5A5A5A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="White"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="White"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="#D0D0D0"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{StaticResource Raised}" BorderBrush="#262626" BorderThickness="1" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WideButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="14" Padding="14,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="#4A4A4A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BareButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.95" ScaleY="0.95"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#000000" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="22" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.7" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Height="50" Background="Transparent" MouseLeftButtonDown="OnDragWindow">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <TextBlock Text="PC" Foreground="White" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text=" Control" Foreground="{StaticResource Muted}" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE72C;" Click="OnRefresh" ToolTip="Yenile"/>
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Küçült"/>
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Tepsiye gizle"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Padding="18,0,18,0">
                <StackPanel>
                    <!-- Lighting -->
                    <TextBlock Style="{StaticResource Label}" Text="AYDINLATMA" Margin="4,6,0,10"/>
                    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="18">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PowerButton" Style="{StaticResource BareButton}" Click="OnPowerClick" Width="96" Height="96">
                                    <Grid>
                                        <Ellipse x:Name="Glow" Width="96" Height="96" Opacity="0">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush>
                                                    <GradientStop Color="#40FFFFFF" Offset="0.6"/>
                                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Ellipse x:Name="Disc" Width="78" Height="78" StrokeThickness="1.5">
                                            <Ellipse.Fill><SolidColorBrush x:Name="DiscFill" Color="White"/></Ellipse.Fill>
                                            <Ellipse.Stroke><SolidColorBrush x:Name="DiscStroke" Color="White"/></Ellipse.Stroke>
                                        </Ellipse>
                                        <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}" FontSize="28"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Foreground><SolidColorBrush x:Name="GlyphFill" Color="Black"/></TextBlock.Foreground>
                                        </TextBlock>
                                        <Ellipse x:Name="Spinner" Width="90" Height="90" StrokeThickness="2" Visibility="Collapsed"
                                                 StrokeDashArray="14 40" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5" Stroke="White">
                                            <Ellipse.RenderTransform><RotateTransform Angle="0"/></Ellipse.RenderTransform>
                                        </Ellipse>
                                    </Grid>
                                </Button>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
                                    <TextBlock x:Name="StateTitle" Text="Işıklar açık" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="StateHint" Text="Kapatmak için dokun" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,18,0,6"/>

                            <ItemsControl x:Name="DeviceList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="#9A9A9A"
                                                       VerticalAlignment="Center" Width="22"/>
                                            <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Faint}" FontSize="11.5"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}"/>
                                            </StackPanel>
                                            <Ellipse Grid.Column="2" Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center"
                                                     ToolTip="{Binding StatusText}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Monitors -->
                    <TextBlock Style="{StaticResource Label}" Text="MONİTÖRLER"/>
                    <ItemsControl x:Name="MonitorList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                        CornerRadius="18" Padding="18,16" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Model}" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Faint}" FontSize="11.5" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE7E8;"
                                                    Tag="{Binding}" Click="OnMonitorPower" ToolTip="{Binding PowerTip}"
                                                    IsEnabled="{Binding CanPower}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Inputs}" Margin="0,14,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource Chip}" Content="{Binding Name}" Tag="{Binding}" Click="OnMonitorInput"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoMonitors" Text="DDC/CI destekli monitör bulunamadı" Foreground="{StaticResource Faint}"
                               FontSize="12" Margin="4,0,0,10" Visibility="Collapsed"/>

                    <Button Style="{StaticResource WideButton}" Click="OnSleepDisplays" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE708;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Tüm ekranları uyut" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <TextBlock Grid.Row="2" x:Name="Footer" Foreground="{StaticResource Faint}" FontSize="11" Margin="22,6,22,16"
                       TextAlignment="Center" TextWrapping="Wrap"/>
        </Grid>
    </Border>
</Window>
